# Environment Configuration
# Copy this file to .env and fill in your values

# API Base URL (used by API server and website)
NEXT_PUBLIC_API_URL=http://localhost:3001
# Optional internal URL for server-side fetches (defaults to http://api:3001 in Docker)
# NEXT_INTERNAL_API_URL=http://api:3001

# Database Configuration
# For local Docker development, use the PostgreSQL container:
DATABASE_URL=postgresql://turborepo:123456789@localhost:5436/turborepo
DATABASE_HOST=localhost
DATABASE_PORT=5436
DATABASE_HOST_INTERNAL=postgres
DATABASE_PORT_INTERNAL=5432
DATABASE_NAME=turborepo
DATABASE_USER=turborepo
DATABASE_PASSWORD=123456789
POSTGRES_USER=turborepo
POSTGRES_PASSWORD=123456789
POSTGRES_DB=turborepo

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_HOST_INTERNAL=redis
REDIS_PORT_INTERNAL=6379
REDIS_PASSWORD=redis_password

# Terminal Sessions
TERMINAL_SESSION_COOKIE_NAME=user_id
TERMINAL_SESSION_TTL_SECONDS=86400
TERMINAL_SESSION_TEXT_LIMIT=3

# Terminal AI Moderation
OPENAI_API_KEY=
TERMINAL_OPENAI_MODEL=gpt-4.1-mini
TERMINAL_AI_DEBUG=false
TERMINAL_RETENTION_DAYS=30

# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
# Used only during initial token exchange
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:3001/api/spotify/callback

# Discord Presence
DISCORD_USER_ID=
# Optional Lanyard base URL override
# LANYARD_API_BASE_URL=https://api.lanyard.rest

# GitHub API
GITHUB_TOKEN=
GITHUB_USERNAME=

# Pterodactyl Panel
PTERODACTYL_API_URL=
PTERODACTYL_API_KEY=
# Optional default identifier for convenience endpoints
# PTERODACTYL_SITE_IDENTIFIER=

# Jellyfin Server
JELLYFIN_BASE_URL=
JELLYFIN_API_KEY=