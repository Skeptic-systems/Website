# Environment Configuration
# Copy this file to .env and fill in your values

# Database Configuration
DATABASE_URL=postgresql://turborepo:123456789@localhost:5436/turborepo
DATABASE_HOST=localhost
DATABASE_PORT=5436
DATABASE_NAME=turborepo
DATABASE_USER=turborepo
DATABASE_PASSWORD=123456789
POSTGRES_USER=turborepo
POSTGRES_DB=turborepo

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=redis_password

# Public API
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_INTERNAL_API_URL=http://api:3001
ALLOWED_ORIGINS=http://localhost:3000,http://192.168.178.160:3000

# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Discord Presence
DISCORD_USER_ID=

# Pterodactyl Panel
PTERODACTYL_API_URL=
PTERODACTYL_API_KEY=
PTERODACTYL_SITE_IDENTIFIER=

# Jellyfin
JELLYFIN_BASE_URL=
JELLYFIN_API_KEY=

# GitHub API
GITHUB_TOKEN=
GITHUB_USERNAME=

# Terminal Sessions
TERMINAL_SESSION_COOKIE_NAME=user_id
TERMINAL_SESSION_TTL_SECONDS=86400
TERMINAL_SESSION_TEXT_LIMIT=3
TERMINAL_SESSION_COOKIE_DOMAIN=
TERMINAL_SESSION_COOKIE_SAME_SITE=
TERMINAL_AI_DEBUG=true
TERMINAL_RETENTION_DAYS=30
OPENAI_API_KEY=
TERMINAL_OPENAI_MODEL=gpt-4.1-mini
BETTER_AUTH_SECRET=