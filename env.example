# Environment Configuration
# Copy this file to .env and fill in your values

# Database Configuration
# For local Docker development, use the PostgreSQL container:
DATABASE_URL=postgresql://turborepo:123456789@localhost:5436/turborepo

# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
# Used only during initial token exchange
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:3001/api/spotify/callback

# Discord Presence
DISCORD_USER_ID=
# Optional Lanyard base URL override
# LANYARD_API_BASE_URL=https://api.lanyard.rest