# Environment Configuration
# Copy this file to .env and fill in your values

# API Base URL (used by API server and website)
NEXT_PUBLIC_API_URL=http://localhost:3001
# Optional internal URL for server-side fetches (defaults to http://api:3001 in Docker)
# NEXT_INTERNAL_API_URL=http://api:3001

# Database Configuration
# For local Docker development, use the PostgreSQL container:
DATABASE_URL=postgresql://turborepo:123456789@localhost:5436/turborepo

# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
# Used only during initial token exchange
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:3001/api/spotify/callback

# Discord Presence
DISCORD_USER_ID=
# Optional Lanyard base URL override
# LANYARD_API_BASE_URL=https://api.lanyard.rest

# GitHub API
GITHUB_TOKEN=
GITHUB_USERNAME=

# Pterodactyl Panel
PTERODACTYL_API_URL=
PTERODACTYL_API_KEY=
# Optional default identifier for convenience endpoints
# PTERODACTYL_SITE_IDENTIFIER=

# Jellyfin Server
JELLYFIN_BASE_URL=
JELLYFIN_API_KEY=