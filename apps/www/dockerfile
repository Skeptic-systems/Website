# syntax=docker/dockerfile:1

FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /app

FROM base AS deps
ENV NODE_ENV=development
RUN corepack enable && corepack prepare pnpm@10.20.0 --activate
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY apps/www/package.json apps/www/package.json
RUN pnpm --filter @website/www... install --frozen-lockfile

FROM deps AS build
COPY apps/www ./apps/www
WORKDIR /app/apps/www
RUN pnpm build

FROM base AS runner
RUN corepack enable && corepack prepare pnpm@10.20.0 --activate
WORKDIR /app/apps/www
ENV PORT=3000
EXPOSE 3000
COPY --from=deps /app/node_modules /app/node_modules
COPY --from=deps /app/apps/www/node_modules /app/apps/www/node_modules
COPY --from=build /app/apps/www/.next ./.next
COPY --from=build /app/apps/www/public ./public
COPY apps/www/package.json ./package.json
CMD ["pnpm", "start"]


