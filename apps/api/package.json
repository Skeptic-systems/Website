{
  "name": "@website/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- bun run src/index.ts",
    "build": "tsdown",
    "postbuild": "node scripts/copy-terminal-context.mjs",
    "start": "dotenv -e ../../.env -- bun dist/index.mjs",
    "type-check": "tsc --noEmit",
    "db:generate": "dotenv -e ../../.env -- drizzle-kit generate:pg",
    "db:migrate": "dotenv -e ../../.env -- bun run src/db/migrate.ts",
    "db:push": "dotenv -e ../../.env -- drizzle-kit push",
    "db:studio": "dotenv -e ../../.env -- drizzle-kit studio"
  },
  "dependencies": {
    "@better-fetch/fetch": "^1.1.21",
    "@hono/node-server": "^2.0.1",
    "@hono/zod-validator": "^0.7.6",
    "@langchain/core": "^1.1.43",
    "@langchain/openai": "^1.4.5",
    "@spotify/web-api-ts-sdk": "^1.2.0",
    "@toon-format/toon": "^2.1.0",
    "better-auth": "^1.6.9",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.18",
    "ioredis": "^5.10.1",
    "kysely": "^0.28.16",
    "langchain": "^1.3.5",
    "neverthrow": "^8.2.0",
    "pg": "^8.20.0",
    "postgres": "^3.4.9",
    "tslog": "^4.10.2",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/pg": "^8.20.0",
    "tsdown": "^0.21.10"
  }
}
