{
  "name": "@website/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- bun run src/index.ts",
    "build": "tsdown",
    "postbuild": "node scripts/copy-terminal-context.mjs",
    "start": "dotenv -e ../../.env -- bun dist/index.mjs",
    "type-check": "tsc --noEmit",
    "db:generate": "dotenv -e ../../.env -- drizzle-kit generate:pg",
    "db:migrate": "dotenv -e ../../.env -- bun run src/db/migrate.ts",
    "db:push": "dotenv -e ../../.env -- drizzle-kit push",
    "db:studio": "dotenv -e ../../.env -- drizzle-kit studio"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@langchain/openai": "^0.2.2",
    "@toon-format/toon": "^1.0.0",
    "drizzle-kit": "^0.31.7",
    "drizzle-orm": "^0.42.0",
    "hono": "^4.9.8",
    "postgres": "^3.4.5",
    "dotenv-cli": "^7.4.4",
    "dotenv": "^16.6.1",
    "@spotify/web-api-ts-sdk": "^1.2.0",
    "langchain": "^0.2.17",
    "zod": "^3.23.8",
    "@hono/zod-validator": "^0.2.1",
    "neverthrow": "^8.2.0",
    "tslog": "^4.9.3",
    "@better-fetch/fetch": "^1.1.18",
    "better-auth": "^1.3.26",
    "ioredis": "^5.8.2",
    "kysely": "^0.27.3",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/pg": "^8.15.5",
    "@types/uuid": "^10.0.0",
    "tsdown": "^0.14.2"
  }
}
